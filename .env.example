DEPT_BANK_ACCOUNT_NAME="กองทุนสาขาวิชาจุลชีววิทยา ม.อ. (Microbiology Dept Fund)"
PROMPTPAY_ID="0458921344"

# Slip Upload Rules
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Default Admin Credentials (ต้องเปลี่ยนก่อน deploy production!)
