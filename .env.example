PORT=5000
NODE_ENV=development

# Security: CORS Allowed Origins (คั่นด้วย comma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=dept_treasury

# Department & System Details
DEPT_NAME="สาขาจุลชีววิทยา คณะวิทยาศาสตร์ มหาวิทยาลัยสงขลานครินทร์"
DEPT_BANK_NAME="ไทยพาณิชย์ (SCB)"
